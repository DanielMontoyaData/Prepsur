APP_ENV=development
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
# Token map JSON. Use one unique long random token per operator/device and tenant.
# Example: {"LONG_RANDOM_TOKEN":{"role":"admin","tenant_id":"friends-01","actor":"owner"}}
PREPPER_TOKENS=
CORS_ORIGINS=http://localhost:8080,tauri://localhost
PUBLIC_BASE_URL=http://localhost:8080
# PostgreSQL is provisioned for the planned PostGIS migration; API event store is SQLite in 2.2.
DATABASE_URL=postgresql://prepper:REPLACE_WITH_PASSWORD@localhost:5432/preppermap

# For a private friends group, create one admin token and issue one-time invites from the app.
# Do not commit real tokens or passwords. Expose the API only behind HTTPS with rate limiting.
