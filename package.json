{
  "name": "prepper-map-pro",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "description": "PREPPER MAP — resiliencia territorial, GIS y coordinación intermunicipal del sur del Valle de Aburrá",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:windows": "tauri build --bundles nsis",
    "build:android": "tauri android build -- --apk",
    "build:android:aab": "tauri android build -- --aab",
    "android:init": "tauri android init",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "doctor": "tauri info",
    "check": "node --check scripts/check-frontend.mjs",
    "sync:vendor": "node scripts/sync-vendor.mjs",
    "prepare:app": "npm run sync:vendor && npm run check",
    "icons:generate": "tauri icon src-tauri/icons/icon.png",
    "build:ios": "tauri ios build -- --export-method app-store-connect",
    "check:offline": "python backend/scripts/mbtiles_to_xyz.py --help",
    "audit:data": "python backend/scripts/quality_report.py",
    "check:release": "python backend/scripts/check_release.py",
    "audit:official-pack": "python backend/scripts/validate_official_pack.py",
    "analyze:route-exposure": "python backend/scripts/analyze_route_exposure.py",
    "download:envigado": "python backend/scripts/extract_arcgis.py --municipality Envigado",
    "inspect:envigado": "python backend/scripts/extract_arcgis.py --municipality Envigado --dry-run",
    "analyze:incident-impact": "python backend/scripts/assess_incident_impact.py",
    "calculate:autonomy": "python backend/scripts/calculate_autonomy.py",
    "analyze:zone-coverage": "python backend/scripts/assess_zone_coverage.py",
    "audit:gis-catalog": "python backend/scripts/audit_gis_catalog.py",
    "audit:gis-remote": "python backend/scripts/audit_gis_catalog.py --remote",
    "download:gis-catalog": "python backend/scripts/audit_gis_catalog.py --remote --download",
    "test:backend": "python -m pytest -q",
    "build:macos": "tauri build --bundles dmg",
    "build:linux": "tauri build --bundles deb,appimage",
    "build:ios:project": "tauri ios init"
  },
  "devDependencies": { "@tauri-apps/cli": "^2.0.0" },
  "dependencies": { "leaflet": "^1.9.4", "esri-leaflet": "^3.0.14" }
}
